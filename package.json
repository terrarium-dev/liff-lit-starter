{
  "name": "liff-lit-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "esbuild src/main.ts --bundle --outfile=public/bundle.js --servedir=public --serve=127.0.0.1:8000 --watch",
    "build": "rm -rf dist && tsc --noEmit && esbuild src/main.ts --bundle --minify --sourcemap --outfile=dist/bundle.js && cp public/index.html dist/index.html",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check": "pnpm typecheck && pnpm lint"
  },
  "packageManager": "pnpm@11.28.11",
  "dependencies": {
    "@line/liff": "2.32.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-security": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
