{
  "name": "liff-lit-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.development scripts/esbuild.config.ts --dev",
    "build": "node --env-file-if-exists=.env.development scripts/esbuild.config.ts",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "lint": "eslint src scripts",
    "check": "pnpm typecheck && pnpm lint"
  },
  "packageManager": "pnpm@11.28.11",
  "dependencies": {
    "@line/liff": "2.32.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-security": "4.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
